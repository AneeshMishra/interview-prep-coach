# Copy this file to .env and fill in the values you need. Every backend
# setting is loaded from an env var prefixed IPC_ (see backend/app/config.py);
# docker compose also reads a .env file in this directory automatically to
# fill in the ${VAR} references in docker-compose.yml.
#
# Never commit your real .env — only this example file is checked in.

# --- Database -----------------------------------------------------------
# SQLite by default; point at Postgres in production (see
# docker/docker-compose.postgres.yml).
IPC_DATABASE_URL=sqlite:////data/interview_prep.db

# --- Vector store (Qdrant) ----------------------------------------------
IPC_QDRANT_URL=http://qdrant:6333
IPC_QDRANT_COLLECTION=interview_questions

# --- Embeddings -----------------------------------------------------------
IPC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM provider: ollama | openai | anthropic ---------------------------
IPC_LLM_PROVIDER=ollama
IPC_LLM_MODEL=llama3
IPC_OLLAMA_BASE_URL=http://ollama:11434
# Only needed if IPC_LLM_PROVIDER is openai/anthropic. Cloud providers
# receive whatever text you send them (questions, answers) — see
# docs/architecture.md for what that implies for private data.
IPC_OPENAI_API_KEY=
IPC_ANTHROPIC_API_KEY=

# --- CORS -----------------------------------------------------------------
# Comma-separated origins the browser is allowed to call the API from.
IPC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Uploads ---------------------------------------------------------------
IPC_MAX_UPLOAD_SIZE_BYTES=10485760
IPC_LOW_CONFIDENCE_THRESHOLD=0.75

# --- Auth: sessions --------------------------------------------------------
# REQUIRED outside local dev. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IPC_JWT_SECRET_KEY=dev-insecure-secret-change-me-in-production-32-bytes-min
IPC_ACCESS_TOKEN_EXPIRE_MINUTES=15
IPC_REFRESH_TOKEN_EXPIRE_DAYS=30
# Where the browser is sent after a successful OAuth login.
IPC_FRONTEND_BASE_URL=http://localhost:3000
# Set to true once the app is served over https — keeps session cookies
# from ever being sent in the clear.
IPC_AUTH_COOKIE_SECURE=false

# --- Auth: Google sign-in ---------------------------------------------------
# 1. https://console.cloud.google.com/apis/credentials -> Create Credentials
#    -> OAuth client ID -> Web application.
# 2. Authorized redirect URI: must exactly match IPC_GOOGLE_OAUTH_REDIRECT_URI
#    below (http://localhost:8000/api/v1/auth/google/callback for the
#    default docker compose setup).
# 3. Copy the generated Client ID / Client Secret here.
# Facebook, LinkedIn and Azure AD SSO are not implemented yet (Google is
# the first provider — see backend/app/auth/oauth/factory.py).
IPC_GOOGLE_CLIENT_ID=
IPC_GOOGLE_CLIENT_SECRET=
IPC_GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Rate limiting (app/rate_limit.py) --------------------------------------
# In-memory, per-process counters — Redis is deferred, and these are
# transient abuse guards, not state that needs to survive a restart. Auth
# is keyed by client IP (no signed-in user yet); uploads and LLM-calling
# endpoints (chat messages, mock interviews) are keyed per signed-in user.
IPC_RATE_LIMIT_AUTH_MAX=10
IPC_RATE_LIMIT_AUTH_WINDOW_SECONDS=60
IPC_RATE_LIMIT_UPLOAD_MAX=10
IPC_RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
IPC_RATE_LIMIT_LLM_MAX=20
IPC_RATE_LIMIT_LLM_WINDOW_SECONDS=60
