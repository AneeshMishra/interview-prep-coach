IPC_DATABASE_URL=sqlite:///./interview_prep.db
IPC_QDRANT_URL=http://localhost:6333
IPC_QDRANT_COLLECTION=interview_questions
IPC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# IPC_LLM_PROVIDER selects which provider below is used; IPC_LLM_MODEL must
# be a model name that provider recognizes (e.g. llama3 for ollama,
# gpt-4o-mini for openai) — it isn't validated against the provider.
IPC_LLM_PROVIDER=ollama
IPC_LLM_MODEL=llama3
IPC_OLLAMA_BASE_URL=http://localhost:11434
# Required if IPC_LLM_PROVIDER=openai
IPC_OPENAI_API_KEY=
IPC_MAX_UPLOAD_SIZE_BYTES=10485760
IPC_LOW_CONFIDENCE_THRESHOLD=0.75
IPC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
