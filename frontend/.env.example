# Optional — defaults to http://localhost:8000/api/v1, which is correct for
# both `npm run dev` and the Docker Compose frontend service (the browser
# always calls the backend on its host-published port, not a container name).
# Baked in at build time (Vite), so changing this requires a rebuild.
VITE_API_BASE_URL=http://localhost:8000/api/v1
